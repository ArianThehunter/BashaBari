# ============================================================
# Bariwala Hub — Root .gitignore
# ============================================================

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ---- IDE ----
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.project
.settings/

# ---- Environment ----
.env
.env.local
.env.*.local
!.env.example

# ---- Node / Frontend ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel

# ---- PHP / Backend ----
/vendor/
storage/*.key
/bootstrap/cache/*.php
.phpunit.result.cache
.php-cs-fixer.cache
Homestead.json
Homestead.yaml
auth.json

# ---- Docker ----
docker-compose.override.yml

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
storage/logs/*.log

# ---- Build artifacts ----
/public/build/
/public/hot

# ---- Testing ----
/coverage/
.nyc_output/
test-results/
playwright-report/

# ---- Misc ----
*.bak
*.tmp
*.pid
*.sqlite
*.sqlite-journal
database.sqlite

# ---- AI Agent & Workspace Scratch Files ----
CLAUDE.md
claude.md
.claude/
AGENTS.md
agents.md
.agents/
.gemini/
.antigravity/
*.scratch
