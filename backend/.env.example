APP_NAME="BashaBari"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Timezone for business dates (rent due, expense dates, statutory windows).
# Timestamps stay UTC; see docs/timezone.md.
APP_BUSINESS_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bashabari
DB_USERNAME=bashabari_user
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=bashabari_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS="localhost,localhost:3000,127.0.0.1,127.0.0.1:8000"

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@bashabari.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SSLCommerz payment gateway
#
# sandbox = locally-signed callbacks, no network calls (local + CI)
# live    = server-to-server validation against SSLCommerz
#
# The sandbox driver still verifies an HMAC over (tran_id, amount), so a
# callback cannot be forged in development either.
# ---------------------------------------------------------------------------
SSLCOMMERZ_DRIVER=sandbox
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# ---------------------------------------------------------------------------
# SMS gateway (Bangladesh)
# ---------------------------------------------------------------------------
SMS_DRIVER=log
SMS_API_KEY=
SMS_SENDER_ID=BashaBari
SMS_BASE_URL=

# Set to true in production behind HTTPS.
SESSION_SECURE_COOKIE=false
